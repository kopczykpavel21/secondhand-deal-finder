<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Monthly BDP harvest wave — runs run_wave.sh on the 1st of each month, 03:40.
  INSTALL (one command):
    cp apps/research-harvester/com.bdp.harvest-wave.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.bdp.harvest-wave.plist
  UNINSTALL:
    launchctl unload ~/Library/LaunchAgents/com.bdp.harvest-wave.plist && rm ~/Library/LaunchAgents/com.bdp.harvest-wave.plist
-->
<dict>
    <key>Label</key>
    <string>com.bdp.harvest-wave</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/Pavel/Downloads/Alexandra_Web/secondhand-deal-finder/apps/research-harvester/run_wave.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Day</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>40</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/Pavel/Downloads/Alexandra_Web/secondhand-deal-finder/apps/research-harvester/data/launchd_wave.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/Pavel/Downloads/Alexandra_Web/secondhand-deal-finder/apps/research-harvester/data/launchd_wave.err</string>
    <key>WorkingDirectory</key>
    <string>/Users/Pavel/Downloads/Alexandra_Web/secondhand-deal-finder/apps/research-harvester</string>
</dict>
</plist>
